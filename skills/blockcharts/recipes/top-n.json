  "charts": [
    {
      "title": "The eight best-selling products of 2024",
      "note": "transform.filter keeps the rows of 2024; transform.sort orders them by revenue, highest first, and limit keeps eight. A band scale lists its categories in row order, so the bars come out ranked. No aggregate is needed when the rows are already one per product.",
      "spec": {
        "data": "products",
        "size": [
          640,
          320
        ],
        "padding": {
          "right": 56
        },
        "transforms": [
          {
            "type": "filter",
            "field": "year",
            "value": 2024
          },
          {
            "type": "sort",
            "field": "revenue",
            "order": "desc",
            "limit": 8
          }
        ],
        "scales": {
          "y": {
            "type": "band"
          },
          "x": {
            "type": "linear",
            "zero": true,
            "nice": true
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "x"
          },
          {
            "type": "axis",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 0
            }
          }
        ],
        "marks": [
          {
            "type": "rect",
            "y": "product",
            "x": "revenue",
            "radius": 2
          },
          {
            "type": "text",
            "y": "product",
            "x": "revenue",
            "text": "revenue",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 0
            },
            "anchor": "start",
            "dx": 6
          }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": [
              "product",
              "revenue"
            ],
            "formats": {
              "revenue": {
                "style": "currency",
                "currency": "USD",
                "notation": "compact",
                "maximumFractionDigits": 0
              }
            }
          }
        ]
      }
    },
    {
      "title": "The best product in each region",
      "note": "With group, sort ranks the rows of each region on their own and limit 1 keeps the top one; regions stay in the order they first appear. The product name is written on its bar.",
      "spec": {
        "data": "regions",
        "size": [
          640,
