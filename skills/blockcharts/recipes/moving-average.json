  "charts": [
    {
      "title": "Daily sign-ups and their 7-day average",
      "note": "transform.window with op \"mean\" and size 7 averages each day with the six before it, so the weekly dip disappears and the trend shows. The first six days have no full week and are left out (partial: true would keep them). Draw the raw values thin and quiet and the average on top.",
      "spec": {
        "data": "signups",
        "size": [
          680,
          300
        ],
        "padding": {
          "right": 100
        },
        "transforms": [
          {
            "type": "window",
            "field": "signups",
            "op": "mean",
            "size": 7,
            "sort": "day",
            "as": "avg7"
          }
        ],
        "scales": {
          "x": {
            "type": "time"
          },
          "y": {
            "type": "linear",
            "zero": true,
            "nice": true
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "format": {
              "month": "short",
              "day": "numeric"
            }
          },
          {
            "type": "axis",
            "scale": "y"
          }
        ],
        "marks": [
          {
            "type": "line",
            "x": "day",
            "y": "signups",
            "stroke": "var(--bc-axis, #9aa3b2)",
            "strokeWidth": 1,
            "opacity": 0.7,
            "label": "name",
            "name": "Daily"
          },
          {
            "type": "line",
            "x": "day",
            "y": "avg7",
            "strokeWidth": 2.5,
            "curve": "smooth",
            "label": "name",
            "name": "7-day avg"
          }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": [
              "day",
              "signups",
              "avg7"
            ],
            "formats": {
              "day": {
                "weekday": "short",
                "month": "short",
                "day": "numeric"
              },
              "avg7": {
                "maximumFractionDigits": 0
              }
            }
          }
        ]
      }
    },
    {
      "title": "Revenue to date, by region",
      "note": "op \"cumsum\" with group: a running total for each region, in the order of sort. Each total is computed over its own region only; end labels name the lines and give the month total.",
      "spec": {
        "data": "sales",
        "size": [
          680,
          300
        ],
        "padding": {
          "right": 130
        },
        "transforms": [
          {
            "type": "window",
            "field": "revenue",
            "op": "cumsum",
            "sort": "day",
            "group": "region",
            "as": "toDate"
          }
        ],
        "scales": {
          "x": {
            "type": "time"
          },
          "y": {
            "type": "linear",
            "zero": true,
            "nice": true
          },
          "color": {
            "type": "color"
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "format": {
              "month": "short",
              "day": "numeric"
            }
          },
          {
            "type": "axis",
            "scale": "y",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 1
            }
          }
        ],
        "marks": [
          {
            "type": "line",
            "x": "day",
            "y": "toDate",
            "color": "region",
            "label": "both",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 1
            }
          }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": [
