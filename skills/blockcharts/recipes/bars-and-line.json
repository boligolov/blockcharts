  "charts": [
    {
      "title": "Revenue by product line, $M (bars) and operating margin (line, right)",
      "note": "All marks of a chart draw from one table. After the stack there is a row per quarter and product, so the line's field must have the same value in every row of a quarter (margin here), or the line jumps up and down within it. The line goes on a second scale y2 with its axis on the right.",
      "spec": {
        "data": "revenue",
        "size": [720, 340],
        "transforms": [{ "type": "stack", "field": "amount", "by": "quarter", "group": "line" }],
        "scales": {
          "x": { "type": "band" },
          "y": { "type": "linear", "zero": true },
          "y2": { "type": "linear", "zero": true, "range": "height" },
          "color": { "type": "color" }
        },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x" },
          { "type": "axis", "scale": "y" },
          { "type": "axis", "scale": "y2", "position": "right", "format": "percent" },
          { "type": "legend", "scale": "color", "position": "auto" }
        ],
        "marks": [
          { "type": "rect", "x": "quarter", "y": "amount1", "y2": "amount0", "color": "line" },
          { "type": "line", "x": "quarter", "y": { "field": "margin", "scale": "y2" }, "stroke": "var(--bc-text, #1e293b)" },
          { "type": "point", "x": "quarter", "y": { "field": "margin", "scale": "y2" }, "r": 4, "fill": "var(--bc-text, #1e293b)" }
        ],
        "interaction": [{ "type": "tooltip", "fields": ["line", "amount", "margin"], "formats": { "margin": "percent" } }]
      }
    }
  ]
}
