{
  "title": "Share over time",
  "data": {
    "sources": {
      "columns": {
        "month": ["2024-01-01", "2024-02-01", "2024-03-01", "2024-04-01", "2024-05-01",
                  "2024-01-01", "2024-02-01", "2024-03-01", "2024-04-01", "2024-05-01",
                  "2024-01-01", "2024-02-01", "2024-03-01", "2024-04-01", "2024-05-01"],
        "source": ["Search", "Search", "Search", "Search", "Search",
                   "Social", "Social", "Social", "Social", "Social",
                   "Direct", "Direct", "Direct", "Direct", "Direct"],
        "visits": [400, 420, 380, 450, 470,
                   250, 300, 320, 310, 280,
                   200, 210, 260, 300, 350]
      }
    }
  },
  "charts": [
    {
      "title": "Traffic mix (100%)",
      "note": "normalize: true scales every stack to 0..1, so the areas show shares rather than totals. follows: the stack is rebuilt when the legend hides a series, so the rest add up to 100% again.",
      "spec": {
        "data": "sources",
        "transforms": [{ "type": "stack", "field": "visits", "by": "month", "group": "source", "normalize": true, "follows": "color" }],
        "scales": {
          "x": { "type": "time" },
          "y": { "type": "linear", "domain": [0, 1] },
          "color": { "type": "color" }
        },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x", "count": 12, "anchor": "end" },
          { "type": "axis", "scale": "y", "format": "percent" },
          { "type": "legend", "scale": "color", "position": "top", "title": "Source" }
        ],
        "marks": [{ "type": "area", "x": "month", "y": "visits1", "y2": "visits0", "color": "source" }],
        "interaction": [{ "type": "tooltip", "fields": ["month", "source", "visits"], "labels": { "source": "Source", "visits": "Visits" }, "formats": { "month": "month" } }, { "type": "legend-filter" }]
      }
    }
  ]
}
