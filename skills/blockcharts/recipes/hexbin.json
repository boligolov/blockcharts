  "charts": [
    {
      "title": "6,000 deliveries: distance and time",
      "note": "City trips form the dense band at the bottom left, the suburbs a second one further out, and late orders a faint layer above both.",
      "how": "A scatter of thousands of points turns into a blot where they pile up. transform.hexbin counts them in hexagons instead, and mark.rect with shape: hexagon draws each one in the box the transform writes, colored by how many deliveries it holds. City trips form the dense band at the bottom left, the suburbs a second one further out, and late orders a faint layer above both. The hexagons are binned for the plot as it is drawn, so they stay regular on a phone too; nice: false keeps the scales to them. exponent: 0.5 on the color scale gives the sparse hexagons more of the colors. The tooltip shows the center of a hexagon and its count.",
      "spec": {
        "data": "deliveries",
        "size": [
          640,
          400
        ],
        "transforms": [
          {
            "type": "hexbin",
            "x": "km",
            "y": "minutes",
            "bins": 26
          }
        ],
        "scales": {
          "x": {
            "type": "linear",
            "nice": false
          },
          "y": {
            "type": "linear",
            "nice": false
          },
          "color": {
            "type": "sequential",
            "exponent": 0.5
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "title": "Distance, km"
          },
          {
            "type": "axis",
            "scale": "y",
            "title": "Delivery time, min"
          },
          {
            "type": "legend",
            "scale": "color",
            "title": "Deliveries"
          }
        ],
        "marks": [
          {
            "type": "rect",
            "shape": "hexagon",
            "x": "x0",
            "x2": "x1",
            "y": "y0",
            "y2": "y1",
            "color": "count"
          }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": [
              "count",
              "km",
              "minutes"
            ],
            "labels": {
              "count": "Deliveries",
              "km": "Around, km",
              "minutes": "Around, min"
            },
            "formats": {
              "km": {
                "maximumFractionDigits": 1
              },
              "minutes": {
                "maximumFractionDigits": 0
              }
            }
          }
        ]
      }
    }
  ]
