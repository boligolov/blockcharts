          { "type": "legend", "scale": "size", "position": "bottom", "format": { "prefix": "$", "suffix": "M" } }
        ],
        "marks": [
          { "type": "point", "x": "growth", "y": "margin", "size": "revenue", "color": "segment", "opacity": 0.75, "stroke": "var(--bc-tooltip-bg, #fff)" }
        ],
        "interaction": [
