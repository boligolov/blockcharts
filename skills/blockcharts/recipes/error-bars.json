  "charts": [
    {
      "title": "Improvement by dose, mean and 95% interval",
      "note": "Error bars: a rule from y (low) to y2 (high) in the middle of each band, and a point at the mean. A scale that does not start at zero is fine here: the points compare positions, not lengths.",
      "spec": {
        "data": "trial",
        "size": [640, 300],
        "scales": { "x": { "type": "band" }, "y": { "type": "linear" } },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x" },
          { "type": "axis", "scale": "y" }
        ],
        "marks": [
          { "type": "rule", "x": "group", "y": "low", "y2": "high", "strokeWidth": 2 },
          { "type": "point", "x": "group", "y": "mean", "r": 5, "fill": "var(--bc-c0, #3a6fe4)" }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": ["mean", "low", "high"],
            "labels": { "mean": "Mean", "low": "Low (95%)", "high": "High (95%)" }
          }
        ]
      }
    },
    {
      "title": "Orders, actual and forecast with its 80% range",
      "note": "A confidence band: an area from y (high) to y2 (low), light, under the lines. The forecast starts at the last actual month, where the band is zero wide, so the lines join. Rows without a value leave the mark out there.",
      "spec": {
        "data": "forecast",
        "size": [720, 320],
        "scales": { "x": { "type": "time" }, "y": { "type": "linear", "zero": true } },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x", "format": { "month": "short" } },
          { "type": "axis", "scale": "y" }
        ],
        "marks": [
          { "type": "area", "x": "month", "y": "high", "y2": "low", "fill": "var(--bc-c0, #3a6fe4)", "opacity": 0.18 },
          { "type": "line", "x": "month", "y": "actual", "stroke": "var(--bc-c0, #3a6fe4)" },
          { "type": "line", "x": "month", "y": "forecast", "stroke": "var(--bc-c0, #3a6fe4)", "dash": [5, 4] }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": ["actual", "forecast", "low", "high"],
            "formats": { "month": { "month": "long", "year": "numeric" } },
            "labels": { "actual": "Actual", "forecast": "Forecast", "low": "Low (80%)", "high": "High (80%)" }
          }
        ]
      }
    }
