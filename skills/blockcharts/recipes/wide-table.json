  "charts": [
    {
      "title": "Revenue per channel",
      "note": "The table has one column per channel, as exported from a spreadsheet. transform.fold turns each row into one row per channel, with the column name in \"channel\" and its number in \"revenue\", so one line mark colored by channel draws all three. No need to reshape the data by hand.",
      "spec": {
        "data": "sales",
        "size": [
          680,
          300
        ],
        "transforms": [
          {
            "type": "fold",
            "fields": [
              "Online",
              "Retail",
              "Partners"
            ],
            "key": "channel",
            "value": "revenue"
          }
        ],
        "scales": {
          "x": {
            "type": "time"
          },
          "y": {
            "type": "linear",
            "zero": true,
            "nice": true
          },
          "color": {
            "type": "color"
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "format": "month"
          },
          {
            "type": "axis",
            "scale": "y",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 0
            }
          },
          {
            "type": "legend",
            "scale": "color",
            "position": "top"
          }
        ],
        "marks": [
          {
            "type": "line",
            "x": "month",
            "y": "revenue",
            "color": "channel",
            "strokeWidth": 2
          }
        ],
        "interaction": [
          {
            "type": "legend-filter"
          },
          {
            "type": "tooltip",
            "fields": [
              "month",
              "channel",
              "revenue"
            ],
            "formats": {
              "revenue": {
                "style": "currency",
                "currency": "USD",
                "notation": "compact",
                "maximumFractionDigits": 0
              },
              "month": "month"
            }
          }
        ]
      }
    },
    {
      "title": "Total per quarter, split by channel",
      "note": "After fold the long table works with every other transform: aggregate sums the months of each quarter per channel, and stack piles the channels up. The quarter is the date it starts on; the axis writes it with the \"quarter\" format.",
      "spec": {
        "data": "sales",
        "size": [
          680,
          300
        ],
        "transforms": [
          {
            "type": "fold",
            "fields": [
              "Online",
              "Retail",
              "Partners"
            ],
            "key": "channel",
            "value": "revenue"
          },
          {
            "type": "aggregate",
            "groupby": [
              {
                "field": "month",
                "unit": "quarter",
                "as": "quarter"
              },
              "channel"
            ],
            "measures": [
              {
                "op": "sum",
                "field": "revenue",
                "as": "revenue"
              }
            ]
          },
          {
            "type": "stack",
            "field": "revenue",
            "by": "quarter",
            "group": "channel"
          }
        ],
        "scales": {
          "x": {
            "type": "band"
          },
          "y": {
            "type": "linear",
            "zero": true,
            "nice": true
          },
          "color": {
            "type": "color"
          }
        },
        "guides": [
          {
            "type": "grid",
            "scale": "y"
          },
          {
            "type": "axis",
            "scale": "x",
            "format": "quarter"
          },
          {
            "type": "axis",
            "scale": "y",
            "format": {
              "style": "currency",
              "currency": "USD",
              "notation": "compact",
              "maximumFractionDigits": 0
            }
          },
          {
            "type": "legend",
            "scale": "color",
            "position": "top"
          }
        ],
        "marks": [
          {
            "type": "rect",
            "x": "quarter",
            "y": "revenue1",
            "y2": "revenue0",
            "color": "channel"
          }
        ],
        "interaction": [
          {
            "type": "legend-filter"
          },
          {
            "type": "tooltip",
            "fields": [
              "quarter",
              "channel",
              "revenue"
            ],
            "formats": {
              "revenue": {
                "style": "currency",
                "currency": "USD",
                "notation": "compact",
                "maximumFractionDigits": 0
              },
              "quarter": "quarter"
            }
          }
        ]
      }
    }
  ]
}
