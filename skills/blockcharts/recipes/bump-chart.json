  "charts": [
    {
      "title": "Market rank by sales, 2020-2025",
      "note": "transform.window with op \"rank\" and group = the year writes each brand's place in that year (1 for the largest; order \"asc\" for the smallest). A line and points per brand on a reversed y (domain [high, low]) is a bump chart: who overtook whom, not by how much. End labels name the lines, so no legend is needed.",
      "spec": {
        "data": "brands",
        "size": [
          720,
          340
        ],
        "padding": {
          "right": 100
        },
        "transforms": [
          {
            "type": "window",
            "field": "sales",
            "op": "rank",
            "group": "year",
            "as": "place"
          }
        ],
        "scales": {
          "x": {
            "type": "band",
            "paddingOuter": 0.1
          },
          "y": {
            "type": "linear",
            "domain": [
              6.4,
              0.6
            ],
            "nice": false
          },
          "color": {
            "type": "color"
          }
        },
        "guides": [
          {
            "type": "axis",
            "scale": "x"
          },
          {
            "type": "axis",
            "scale": "y",
            "format": {
              "maximumFractionDigits": 0,
              "prefix": "#"
            }
          }
        ],
        "marks": [
          {
            "type": "line",
            "x": "year",
            "y": "place",
            "color": "brand",
            "strokeWidth": 3,
            "label": "name"
          },
          {
            "type": "point",
            "x": "year",
            "y": "place",
            "color": "brand",
            "r": 5
          }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": [
              "brand",
              "place",
              "sales"
            ]
          }
        ]
      }
    }
  ]
