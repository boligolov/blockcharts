{
  "title": "Two scales on one chart",
  "data": {
    "monthly": [
      { "month": "2025-01-01", "revenue": 120, "units": 3400 }, { "month": "2025-02-01", "revenue": 150, "units": 3900 },
      { "month": "2025-03-01", "revenue": 130, "units": 5200 }, { "month": "2025-04-01", "revenue": 180, "units": 4800 },
      { "month": "2025-05-01", "revenue": 210, "units": 6100 }, { "month": "2025-06-01", "revenue": 190, "units": 7300 },
      { "month": "2025-07-01", "revenue": 260, "units": 6900 }, { "month": "2025-08-01", "revenue": 240, "units": 8800 }
    ]
  },
  "charts": [
    {
      "title": "Revenue and units sold by month",
      "note": "Revenue doubled from January to August; units sold grew faster, from 3,400 to 8,800.",
      "how": "y2 is a second linear scale. A mark chooses it with { field, scale }, and its axis goes to the right with position. Both axes are titled and start at zero, and the legend names the marks: each takes its name as a constant on the color scale.",
      "spec": {
        "data": "monthly",
        "size": [720, 320],
        "scales": {
          "x": { "type": "band", "paddingInner": 0.3 },
          "y": { "type": "linear", "zero": true },
          "y2": { "type": "linear", "zero": true, "range": "height" },
          "color": { "type": "color" }
        },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x", "format": { "month": "short" }, "anchor": "end" },
          { "type": "axis", "scale": "y", "title": "Revenue, $K" },
          { "type": "axis", "scale": "y2", "position": "right", "title": "Units sold", "format": "compact" },
          { "type": "legend", "scale": "color", "position": "top" }
        ],
        "marks": [
          { "type": "rect", "x": "month", "y": "revenue", "color": { "value": "Revenue", "scale": "color" }, "radius": 3 },
          { "type": "line", "x": "month", "y": { "field": "units", "scale": "y2" }, "color": { "value": "Units sold", "scale": "color" } },
          { "type": "point", "x": "month", "y": { "field": "units", "scale": "y2" }, "color": { "value": "Units sold", "scale": "color" }, "r": 4 }
        ],
        "interaction": [
          {
            "type": "tooltip",
            "fields": ["revenue", "units"],
            "labels": { "revenue": "Revenue", "units": "Units sold" },
            "formats": {
              "month": { "month": "long", "year": "numeric" },
              "revenue": { "style": "currency", "currency": "USD", "maximumFractionDigits": 0, "suffix": "K" },
              "units": "integer"
            }
          }
        ]
      }
    }
  ]
}
