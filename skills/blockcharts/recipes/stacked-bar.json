{
  "title": "Stacked bars",
  "data": {
    "revenue": [
      { "quarter": "Q1", "line": "Hardware", "amount": 30 },
      { "quarter": "Q1", "line": "Software", "amount": 20 },
      { "quarter": "Q1", "line": "Services", "amount": 10 },
      { "quarter": "Q2", "line": "Hardware", "amount": 35 },
      { "quarter": "Q2", "line": "Software", "amount": 25 },
      { "quarter": "Q2", "line": "Services", "amount": 15 },
      { "quarter": "Q3", "line": "Hardware", "amount": 28 },
      { "quarter": "Q3", "line": "Software", "amount": 30 },
      { "quarter": "Q3", "line": "Services", "amount": 22 },
      { "quarter": "Q4", "line": "Hardware", "amount": 40 },
      { "quarter": "Q4", "line": "Software", "amount": 28 },
      { "quarter": "Q4", "line": "Services", "amount": 26 }
    ]
  },
  "charts": [
    {
      "title": "Revenue by product line",
      "note": "The stack transform adds amount0 (start) and amount1 (end) to every row; the rect draws from amount0 to amount1.",
      "spec": {
        "data": "revenue",
        "size": [640, 320],
        "transforms": [{ "type": "stack", "field": "amount", "by": "quarter", "group": "line" }],
        "scales": {
          "x": { "type": "band" },
          "y": { "type": "linear", "zero": true },
          "color": { "type": "color" }
        },
        "guides": [
          { "type": "grid", "scale": "y" },
          { "type": "axis", "scale": "x" },
          { "type": "axis", "scale": "y" },
          { "type": "legend", "scale": "color" }
        ],
        "marks": [{ "type": "rect", "x": "quarter", "y": "amount1", "y2": "amount0", "color": "line" }],
        "interaction": [{ "type": "tooltip", "fields": ["quarter", "line", "amount"] }]
      }
    }
  ]
}
