---
// The page for an address the site does not have. Cloudflare serves it with a 404 (assets.not_found_handling in
// wrangler.jsonc); its links start at the site's base, so they work from whatever address it is shown at.
import Base from '../layouts/Base.astro';
import { baseUrl, loadRelease } from '../lib/site.mjs';

const base = baseUrl(import.meta.env.BASE_URL);
const release = loadRelease();
---
<Base title="Page not found" noindex version={release.version} description="There is no page at this address on blockcharts.online. The gallery of live charts, the guide and the reference of every block are a click away.">
  <h1>Page not found</h1>
  <p class="lead">There is nothing at this address: the page may have moved, or the link may have a typo in it.</p>
  <ul>
    <li><a href={base}>The home page</a>: what blockcharts is, and how to install the skill</li>
    <li><a href={`${base}examples/`}>The gallery</a>: every chart, live, with its JSON and its report</li>
    <li><a href={`${base}guide/`}>The guide</a> and <a href={`${base}blocks/`}>every block</a> with its parameters</li>
  </ul>
</Base>
