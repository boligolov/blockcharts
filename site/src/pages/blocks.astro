---
import Base from '../layouts/Base.astro';
import { kb, loadBlocks, loadRelease, loadSizes, ROLES, scaleWords, scalesFitting } from '../lib/site.mjs';
import { BLOCK_SUMMARY, CORE_USE, ROLE_TEXT } from '../lib/catalog.mjs';

const manifest = loadBlocks();
const release = loadRelease();
const sizes = loadSizes();
const roles = ROLE_TEXT;
// the roles come from the manifest builder; a role without its text here (or a text for a role that is gone) fails the build
for (const role of ROLES) if (!roles[role]) throw new Error(`blocks page: no text for the role "${role}"`);
for (const role of Object.keys(roles)) if (ROLES.indexOf(role) < 0) throw new Error(`blocks page: "${role}" is not a role`);

// what each block does, in a line; every block needs one, and one for a block that does not exist fails the build too
const summary = BLOCK_SUMMARY;
for (const b of sizes.blocks) if (!summary[b.name]) throw new Error(`blocks page: no summary for ${b.name}`);
for (const name of Object.keys(summary)) if (!sizes.blocks.some((b) => b.name === name)) throw new Error(`blocks page: a summary for ${name}, which is not a block`);
const coreUse = CORE_USE;
for (const c of sizes.core) if (!coreUse[c.name]) throw new Error(`blocks page: no text for ${c.name}`);
const totals = sizes.blocks.reduce((t, b) => ({ source: t.source + b.source, min: t.min + b.min, gzip: t.gzip + b.gzip }), { source: 0, min: 0, gzip: 0 });
const kind = (d) => (d.kind === 'enum' ? (d.values || []).map((v) => `"${v}"`).join(' | ') : d.kind);
// a channel accepts scales by what they declare: the ones there are, and what that is
const scalesOf = (d) =>
  d.unscaled ? 'a plain field' : d.accepts ? `${scalesFitting(d.accepts, manifest).join(', ')} (one that ${scaleWords(d.accepts.output, d.accepts.input)})` : 'any';
const total = Object.keys(manifest.blocks).length;
const k = (n) => (n / 1024).toFixed(1);
// a name may break after its role ("interaction." / "crosshair"), so the column of names fits a phone with the sizes beside it
const parts = (name) => {
  const i = name.indexOf('.');
  return i < 0 ? [name, ''] : [name.slice(0, i + 1), name.slice(i + 1)];
};
---
<Base title="Chart blocks: parameters, channels and sizes" nav="blocks" version={release.version} description="Every blockcharts block (scales, transforms, marks, axes, legends, interactions, renderers) with its parameters, channels and size in KB, minified and gzipped.">
  <h1>Blocks</h1>
  <p class="lead">{total} blocks in {ROLES.length} roles. This page is generated from the code: a parameter that does not exist here does not exist.</p>
  <p><a href="#sizes">What each block weighs</a> · {ROLES.map((role, i) => <>{i ? ' · ' : ''}<a href={`#${role}`}>{role}</a></>)}</p>

  <h2 id="sizes">What each block weighs</h2>
  <p>A report carries the core and only the blocks its charts use. <b>Source</b> is the TypeScript file with its comments and docs. <b>Minified</b> is what goes into the HTML file of a report: the weight that counts, since the file is opened as it is. <b>gzip</b> is the minified file compressed, what a CDN sends for a kit; inside one page the blocks compress better together. Sizes in KB.</p>

  <h3>The core: one per page</h3>
  <div class="sizes-wrap"><table class="sizes">
    <thead><tr><th>Core</th><th class="what">When</th><th class="n">Source</th><th class="n">Minified</th><th class="n">gzip</th></tr></thead>
    <tbody>
      {sizes.core.map((c) => (
        <tr><td><code>{parts(c.name)[0]}<wbr />{parts(c.name)[1]}</code><div class="sum">{coreUse[c.name]}</div></td><td class="what">{coreUse[c.name]}</td><td class="n num">{k(c.source)}</td><td class="n num"><b>{k(c.min)}</b></td><td class="n num">{k(c.gzip)}</td></tr>
      ))}
    </tbody>
  </table></div>

  <h3>The blocks: only the ones a page uses</h3>
  <div class="sizes-wrap"><table class="sizes">
    <thead><tr><th>Block</th><th class="what">What it does</th><th class="n">Source</th><th class="n">Minified</th><th class="n">gzip</th></tr></thead>
    <tbody>
      {ROLES.map((role) => (
        <>
          <tr class="group"><th colspan="5"><a href={`#${role}`}>{role}</a></th></tr>
          {sizes.blocks.filter((b) => b.role === role).map((b) => (
            <tr>
              <td><a href={`#${b.name}`}><code>{parts(b.name)[0]}<wbr />{parts(b.name)[1]}</code></a><div class="sum">{summary[b.name]}</div></td>
              <td class="what">{summary[b.name]}{b.requires.length > 0 && <span class="muted"> Needs {b.requires.join(', ')}.</span>}</td>
              <td class="n num">{k(b.source)}</td><td class="n num"><b>{k(b.min)}</b></td><td class="n num">{k(b.gzip)}</td>
            </tr>
          ))}
        </>
      ))}
    </tbody>
    <tfoot><tr><th>All {sizes.blocks.length} blocks</th><td class="what"></td><td class="n num">{k(totals.source)}</td><td class="n num"><b>{k(totals.min)}</b></td><td class="n num">{k(totals.gzip)}</td></tr></tfoot>
  </table></div>

  {ROLES.map((role) => [role, roles[role]]).map(([role, about]) => (
    <>
      <h2 id={role}>{role}</h2>
      <p set:html={about} />
      {Object.keys(manifest.blocks).filter((n) => n.startsWith(role + '.')).map((name) => {
        const b = manifest.blocks[name];
        const file = release.blocks[name];
        const params = Object.entries(b.params || {});
        const channels = Object.entries(b.channels || {});
        return (
          <div class="block" id={name}>
            <h3>{name}</h3>
            {b.output && <p><b>It {scaleWords(b.output, [b.input])}.</b></p>}
            <p>{b.doc}</p>
            <p class="muted">
              <span class="pill">v{b.version}</span><span class="pill">{kb(file.bytes)} ({kb(file.gzip)} gzip)</span>
              {b.requires.length > 0 && <span class="pill">needs {b.requires.join(', ')}</span>}
            </p>
            {params.length > 0 && (
              <table class="stack">
                <thead><tr><th>Parameter</th><th>Type</th><th>Default</th><th><span class="sr">What it does</span></th></tr></thead>
                <tbody>
                  {params.map(([p, d]) => (
                    <tr>
                      <td><code>{p}</code></td>
                      <td>{kind(d)}{d.required && <> <b>required</b></>}</td>
                      <td data-label="default">{d.default !== undefined && <code>{JSON.stringify(d.default)}</code>}</td>
                      <td class="doc">{d.doc}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {channels.length > 0 && (
              <table class="stack">
                <thead><tr><th>Channel</th><th><span class="sr">Required</span></th><th>Scales</th><th><span class="sr">What it does</span></th></tr></thead>
                <tbody>
                  {channels.map(([c, d]) => <tr><td><code>{c}</code></td><td>{d.required ? <b>required</b> : 'optional'}</td><td data-label="scales">{scalesOf(d)}</td><td class="doc">{d.doc}</td></tr>)}
                </tbody>
              </table>
            )}
          </div>
        );
      })}
    </>
  ))}
</Base>
