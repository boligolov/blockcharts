---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Principles from '../components/Principles.astro';
import Stats from '../components/Stats.astro';
import Features from '../components/Features.astro';
import WaysIn from '../components/WaysIn.astro';
import Gallery from '../components/Gallery.astro';
import BlockMap from '../components/BlockMap.astro';
import Customize from '../components/Customize.astro';
import { baseUrl, blocksNeeded, jsonForScript, lakeOf, loadPageCode, loadRecipes, loadRelease, loadReportSizes } from '../lib/site.mjs';

const base = baseUrl(import.meta.env.BASE_URL);
const release = loadRelease();
const sizes = loadReportSizes();
const recipes = loadRecipes();
const recipe = (name: string) => {
  const r = recipes.find((x) => x.name === name);
  if (!r) throw new Error(`no recipe ${name}`);
  return r;
};

const heroRecipe = recipe('executive-dashboard');
const galleryNames = ['waterfall', 'funnel', 'treemap', 'bullet', 'grouped-bar', 'lines-by-series'];
const gallery = galleryNames.map(recipe);
const { lake, charts } = lakeOf([heroRecipe, ...gallery]);

const heroCharts = charts.get('executive-dashboard');
const blocksOf = new Map([heroRecipe, ...gallery].map((r) => [r.name, blocksNeeded(r)]));
const code = loadPageCode();
const totalBlocks = code.blocks.length;
const blockList = code.blocks;
const blockRange: [number, number] = [Math.min(...blockList.map((b) => b.bytes)), Math.max(...blockList.map((b) => b.bytes))];
const allBytes = code.all;
const sizePages = [
  ['pie', 'A pie chart'],
  ['bar', 'A bar chart with labels'],
  ['report-from-csv', 'A sales report from CSV'],
  ['executive-dashboard', 'An executive dashboard, 8 charts'],
].map(([name, label]) => ({ label, bytes: sizes[name], blocks: blocksNeeded(recipe(name)).length }));
---
<Base title="blockcharts" landing version={release.version} description="Atomic charts for HTML dashboards: a page carries exactly the chart blocks it uses, nothing more. Light, customizable, and an agent skill that turns your data into one HTML report.">
  <script is:inline src={`${base}release/kits/full.js`}></script>
  <script is:inline type="application/json" id="bc-data" set:html={jsonForScript(lake)} />

  <Hero tiles={heroCharts.slice(0, 2)} trend={{ ...heroCharts[4], spec: { ...heroCharts[4].spec, size: [620, 250] } }} file="executive-dashboard.html" recipe="executive-dashboard" codeBytes={sizes['executive-dashboard']} blocks={blocksOf.get('executive-dashboard').length} totalBlocks={totalBlocks} coreGzip={code.core.gzip} blockRange={blockRange} />
  <BlockMap blocks={blockList} used={blocksOf.get('executive-dashboard')} coreBytes={code.core.bytes} file="executive-dashboard.html" />
  <HowItWorks />
  <Stats blocks={totalBlocks} coreBytes={code.core.bytes} coreGzip={code.core.gzip} allBytes={allBytes} pages={sizePages} />
  <Customize />
  <Principles />
  <Features />
  <WaysIn basicGzip={release.kits.basic.js.gzip} loaderBytes={release.loader.bytes} version={release.version} />
  <Gallery items={gallery.map((r) => ({ name: r.name, title: r.title, need: r.need, spec: charts.get(r.name)[0].spec, bytes: sizes[r.name], blocks: blocksOf.get(r.name).length }))} />

  <section class="section alt cta-band">
    <div class="wrap">
      <h2>Your next dashboard, with nothing extra in it</h2>
      <p>Install the skill, give Claude a table, and get one light HTML file with exactly the chart code it needs.</p>
      <div class="ctas">
        <a class="btn btn-primary" href="#install">Get the skill</a>
        <a class="btn btn-secondary" href={`${base}examples/`}>See live examples</a>
      </div>
    </div>
  </section>
</Base>
