---
import Base from '../../layouts/Base.astro';
import Snippet from '../../components/Snippet.astro';
import { baseUrl, embedPages, loadRelease } from '../../lib/site.mjs';

export function getStaticPaths() {
  const base = baseUrl(import.meta.env.BASE_URL);
  return embedPages(base, loadRelease()).map((p) => ({ params: { page: p.file.replace(/\.html$/, '') }, props: { page: p } }));
}

const base = baseUrl(import.meta.env.BASE_URL);
const { page } = Astro.props;
const release = loadRelease();
// a copy button says what it copies: the code of which section (a heading may hold markup)
const of = (h: string) => `“${h.replace(/<[^>]+>/g, '')}”`;
---
<Base title={page.title} nav="embed" version={release.version} description={page.description || page.lead.replace(/<[^>]+>/g, '')}>
  <p class="muted"><a href={`${base}embed/`}>Embedding</a> /</p>
  <h1>{page.title}</h1>
  <p class="lead" set:html={page.lead} />
  {page.sections.map((s) => (
    <>
      <h2 set:html={s.h} />
      {s.p && <p set:html={s.p} />}
      {(s.html || s.htmlLiveOnly) && <div class="demo" set:html={s.html || s.htmlLiveOnly} />}
      {s.extra && <Fragment set:html={s.extra} />}
      {s.extraAfter && <Fragment set:html={s.extraAfter} />}
      {s.note && <p class="muted" set:html={s.note} />}
      {s.html && <Snippet code={s.shown || s.html} label="HTML" name={`the HTML of ${of(s.h)}`} />}
      {s.code && <Snippet code={s.code} label={s.label} name={`the code of ${of(s.h)}`} />}
    </>
  ))}
</Base>
