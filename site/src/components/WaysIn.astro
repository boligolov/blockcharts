---
// The four ways in. An app is the main one (npm and a ready component); a page of your own takes a kit or the loader; a
// report file comes from the agent skill, or from the same composer run by a script.
import Highlight from './Highlight.astro';
import { baseUrl, kb, scriptTag } from '../lib/site.mjs';

interface Props { basicGzip: number; loaderBytes: number; version: string }
const { basicGzip, loaderBytes, version } = Astro.props;
const base = baseUrl(import.meta.env.BASE_URL);
const ways = [
  {
    title: 'Components',
    for_: 'For apps in React, Vue, Svelte, Angular',
    body: 'Install from npm, import a kit once, and use a ready component: BlockChart for React and Vue, an action for Svelte, the <block-chart> element for Angular and any page. Clicks come back with the row.',
    code: "import { BlockChart } from 'blockcharts/react';", lang: 'javascript',
    href: '#start', more: 'Get started', featured: true,
  },
  {
    title: 'One script tag',
    for_: 'For your own pages',
    body: `A kit is the core and a set of blocks in one file, from npm, a CDN or your own site — ${kb(basicGzip)} gzipped for bars, lines and areas. Charts are JSON in the HTML.`,
    code: 'npm install blockcharts', lang: 'shellscript',
    href: `${base}embed/kit/`, more: 'Try a kit',
  },
  {
    title: 'Loader',
    for_: 'For sites with many different charts',
    body: `A ${kb(loaderBytes)} script finds the charts on a page and fetches only the blocks they use, with SRI hashes from the release manifest.`,
    code: scriptTag(`.../${version}/loader.js`, { 'data-auto': true }), lang: 'html',
    href: `${base}embed/loader/`, more: 'Try the loader',
  },
  {
    title: 'Agent skill',
    for_: 'For report files, from a table',
    body: 'Claude writes the JSON, the bundled composer checks it against the data and writes one HTML file that opens anywhere. The same composer runs from a script or CI.',
    // what you ask once it is installed; the plugin's /plugin install comes back with the Claude Code tab (ROADMAP)
    code: 'make a report of revenue by region from sales.csv', lang: 'plaintext',
    href: '#install', more: 'Get the skill',
  },
];
---
<section class="section alt" id="ways-in">
  <div class="wrap">
    <p class="kicker">Four ways in</p>
    <h2>One set of blocks, however you ship it</h2>
    <p class="intro">In an app, install from npm and use a component. In a page of your own, one script tag. For a report file to send around, the agent skill — pick by where the charts will live.</p>
    <div class="cards four">
      {ways.map((w) => (
        <div class={w.featured ? 'tile featured' : 'tile'}>
          <h3>{w.title}</h3>
          <p class="for">{w.for_}</p>
          <p>{w.body}</p>
          <Highlight code={w.code} lang={w.lang} />
          <a class="more" href={w.href}>{w.more} →</a>
        </div>
      ))}
    </div>
  </div>
</section>
