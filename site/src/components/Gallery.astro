---
// A few of the skill's recipes, drawn live, each with the size of the code its composed report carries.
import { baseUrl, jsonForScript, kb } from '../lib/site.mjs';

interface Props { items: { name: string; title: string; need: string; spec: unknown; bytes: number; blocks: number }[] }
const { items } = Astro.props;
const base = baseUrl(import.meta.env.BASE_URL);
---
<section class="section" id="gallery">
  <div class="wrap">
    <p class="kicker">Gallery</p>
    <h2>The charts business reports are made of</h2>
    <p class="intro">Each one is a recipe the skill ships, drawn live here. Open one to see its JSON and the report the composer makes from it.</p>
    <div class="gallery">
      {items.map((it) => (
        <div class="shot">
          <h3><a href={`${base}examples/${it.name}/`}>{it.title}</a></h3>
          <p>{it.need}</p>
          <script is:inline type="application/json" data-bc-chart set:html={jsonForScript(it.spec)} />
          <div class="foot"><span>{it.blocks} blocks</span><span class="num">{kb(it.bytes)} of code</span></div>
        </div>
      ))}
    </div>
    <div class="section-more">
      <a class="btn btn-secondary" href={`${base}examples/`}>All examples</a>
    </div>
  </div>
</section>
