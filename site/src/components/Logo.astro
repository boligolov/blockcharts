---
// Three columns of stacked blocks that read as a bar chart: charts assembled from blocks.
---
<svg viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--accent)" />
  <g fill="var(--accent-ink)">
    <rect x="6" y="20" width="5.5" height="5.5" rx="1.2" />
    <rect x="13.25" y="20" width="5.5" height="5.5" rx="1.2" />
    <rect x="13.25" y="13" width="5.5" height="5.5" rx="1.2" opacity=".8" />
    <rect x="20.5" y="20" width="5.5" height="5.5" rx="1.2" />
    <rect x="20.5" y="13" width="5.5" height="5.5" rx="1.2" opacity=".8" />
    <rect x="20.5" y="6" width="5.5" height="5.5" rx="1.2" opacity=".6" />
  </g>
</svg>
