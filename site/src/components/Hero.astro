---
// The first screen: the one idea (a page carries only the blocks its charts use) and a piece of a real dashboard made from
// one of the skill's recipes, drawn live: two KPI tiles over a trend. The size tags are those of that recipe's report.
import { baseUrl, jsonForScript, kb } from '../lib/site.mjs';

interface Chart { title?: string; note?: string; spec: unknown }
interface Props { tiles: Chart[]; trend: Chart; file: string; recipe: string; codeBytes: number; blocks: number; totalBlocks: number; coreGzip: number; blockRange: [number, number] }
const { tiles, trend, file, recipe, codeBytes, blocks, totalBlocks, coreGzip, blockRange } = Astro.props;
const base = baseUrl(import.meta.env.BASE_URL);
---
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <p class="kicker">Atomic charts for HTML dashboards</p>
      <h1>Only the chart code your page needs. <em>Nothing more.</em></h1>
      <p class="pitch">
        blockcharts is a chart library cut into atoms: a scale, a bar, an axis, a tooltip — each one a tiny block. A page carries exactly
        the blocks its charts use, never the whole library. Ask Claude for a dashboard and get one light HTML file that opens anywhere, offline.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="#install">Get the skill</a>
        <a class="btn btn-secondary" href="#blocks-inside">What is inside</a>
      </div>
      <ul class="facts">
        <li>Core {kb(coreGzip)} gzipped</li>
        <li>Blocks {(blockRange[0] / 1024).toFixed(1)}–{(blockRange[1] / 1024).toFixed(0)} KB each</li>
        <li>Customizable down to your own block</li>
        <li>Free, MIT license</li>
      </ul>
    </div>
    <div>
      <div class="window">
        <div class="window-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="file">{file}</span>
          <span class="meta">
            <span class="tag neutral">{blocks} of {totalBlocks} blocks</span>
            <span class="tag num">{kb(codeBytes)} of code</span>
          </span>
        </div>
        <div class="window-body">
          <div class="tiles">
            {tiles.map((c) => (
              <div class="tile-card"><script is:inline type="application/json" data-bc-chart set:html={jsonForScript(c.spec)} /></div>
            ))}
          </div>
          <div class="chart-card">
            {trend.title && <h3>{trend.title}</h3>}
            <script is:inline type="application/json" data-bc-chart set:html={jsonForScript(trend.spec)} />
          </div>
        </div>
      </div>
      <p class="window-caption">
        Live, from the <a href={`${base}examples/${recipe}/`}>{recipe}</a> recipe — see <a href={`${base}examples/${recipe}.report.html`}>the whole dashboard</a>.
        Hover the lines.
      </p>
    </div>
  </div>
</section>
