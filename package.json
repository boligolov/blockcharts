{
  "name": "blockcharts",
  "version": "0.0.4",
  "description": "Interactive SVG and canvas charts described as JSON, assembled from independent blocks. For standalone HTML reports and for pages of your own.",
  "keywords": [
    "charts",
    "visualization",
    "svg",
    "canvas",
    "json",
    "report",
    "dashboard",
    "zoom",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "Aleksandr Lisin",
  "homepage": "https://blockcharts.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boligolov/blockcharts.git"
  },
  "bugs": {
    "url": "https://github.com/boligolov/blockcharts/issues"
  },
  "type": "commonjs",
  "main": "./release/kits/full.js",
  "module": "./release/kits/full.mjs",
  "types": "./release/kits/full.d.ts",
  "unpkg": "./release/kits/full.js",
  "jsdelivr": "./release/kits/full.js",
  "exports": {
    ".": {
      "import": {
        "types": "./release/kits/full.d.mts",
        "default": "./release/kits/full.mjs"
      },
      "require": {
        "types": "./release/kits/full.d.ts",
        "default": "./release/kits/full.js"
      },
      "default": "./release/kits/full.js"
    },
    "./kits/*": "./release/kits/*",
    "./blocks/*": "./release/blocks/*",
    "./core.js": "./release/core.js",
    "./loader.js": "./release/loader.js",
    "./manifest.json": "./release/manifest.json",
    "./bc.d.ts": "./release/bc.d.ts",
    "./schema/*": "./release/schema/*",
    "./react": {
      "types": "./release/frameworks/react.d.mts",
      "default": "./release/frameworks/react.mjs"
    },
    "./vue": {
      "types": "./release/frameworks/vue.d.mts",
      "default": "./release/frameworks/vue.mjs"
    },
    "./svelte": {
      "types": "./release/frameworks/svelte.d.mts",
      "default": "./release/frameworks/svelte.mjs"
    },
    "./element": {
      "types": "./release/frameworks/element.d.mts",
      "default": "./release/frameworks/element.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "release",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.frameworks.json",
    "manifest": "node scripts/build-manifest.js && node scripts/minify.js",
    "test": "npm run build && npm run manifest && node scripts/test.js && node scripts/test-canvas.js && node scripts/test-compose.js && node scripts/test-csv.js && node scripts/test-skill.js && node scripts/test-dist.js && node scripts/test-schema.js",
    "test:chrome": "npm run build && npm run manifest && node scripts/test-chrome.js",
    "test:frameworks": "npm run build && npm run manifest && node scripts/test-frameworks.js",
    "test:apps": "node scripts/test-apps.js",
    "bench": "npm run build && npm run manifest && node scripts/bench.js",
    "skill": "npm run build && npm run manifest && node scripts/build-skill.js && node scripts/build-docs.js",
    "release": "npm run build && npm run manifest && node scripts/build-dist.js",
    "og": "node scripts/og-image.js",
    "test:site": "node scripts/check-site-phone.js",
    "site": "npm run build && npm run manifest && npm run build -w site && node scripts/check-site.js",
    "dev": "npm run build && npm run manifest && npm run dev -w site",
    "serve": "npm run site && npm run preview -w site",
    "prepack": "npm run release",
    "format": "prettier --write \"src/**/*.{ts,mts}\" \"scripts/**/*.js\" \"site/src/**/*.{mjs,css}\" site/astro.config.mjs \"test/apps/**/*.{js,jsx,mjs,ts,vue}\" \"test/bench/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,mts}\" \"scripts/**/*.js\" \"site/src/**/*.{mjs,css}\" site/astro.config.mjs \"test/apps/**/*.{js,jsx,mjs,ts,vue}\" \"test/bench/*.js\""
  },
  "devDependencies": {
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.59.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.46"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": false
  }
}
