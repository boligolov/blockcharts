{
  "name": "blockcharts",
  "version": "0.1.0",
  "description": "Interactive SVG and canvas charts described as JSON, assembled from independent blocks. For standalone HTML reports and for pages of your own.",
  "keywords": [
    "charts",
    "visualization",
    "svg",
    "canvas",
    "json",
    "report",
    "dashboard",
    "zoom",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "Alexander Lisin",
  "homepage": "https://blockcharts.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boligolov/blockcharts.git"
  },
  "bugs": {
    "url": "https://github.com/boligolov/blockcharts/issues"
  },
  "type": "commonjs",
  "main": "./release/kits/full.js",
  "module": "./release/kits/full.mjs",
  "types": "./release/kits/full.d.ts",
  "unpkg": "./release/kits/full.js",
  "jsdelivr": "./release/kits/full.js",
  "exports": {
    ".": {
      "import": {
        "types": "./release/kits/full.d.mts",
        "default": "./release/kits/full.mjs"
      },
      "require": {
        "types": "./release/kits/full.d.ts",
        "default": "./release/kits/full.js"
      },
      "default": "./release/kits/full.js"
    },
    "./kits/*": "./release/kits/*",
    "./blocks/*": "./release/blocks/*",
    "./core.js": "./release/core.js",
    "./loader.js": "./release/loader.js",
    "./manifest.json": "./release/manifest.json",
    "./bc.d.ts": "./release/bc.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "release",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "build": "tsc",
    "manifest": "node scripts/build-manifest.js && node scripts/minify.js",
    "test": "npm run build && npm run manifest && node scripts/test.js && node scripts/test-canvas.js && node scripts/test-compose.js && node scripts/test-csv.js && node scripts/test-skill.js && node scripts/test-dist.js",
    "test:chrome": "npm run build && npm run manifest && node scripts/test-chrome.js",
    "page": "npm run build && npm run manifest && node scripts/page.js",
    "skill": "npm run build && npm run manifest && node scripts/build-skill.js && node scripts/build-docs.js",
    "release": "npm run build && npm run manifest && node scripts/build-dist.js",
    "og": "node scripts/og-image.js",
    "test:site": "node scripts/check-site-phone.js",
    "site": "npm run build && npm run manifest && npm run build -w site && node scripts/check-site.js",
    "prepack": "npm run release",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.js\" \"site/src/**/*.{mjs,css}\" site/astro.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.js\" \"site/src/**/*.{mjs,css}\" site/astro.config.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": false
  }
}
